# Where /api/* is forwarded (next.config.ts rewrites). Server-only: the browser always calls
# this app's own /api, never the backend directly. Read at build time. Defaults to
# http://127.0.0.1:8000 locally; required on Vercel.
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_VERCEL_BLOB_UPLOADS=false
