OPENROUTER_API_KEY=
# The summary model.
OPENROUTER_MODEL=openai/gpt-4o
# Optional. The chat answer model; empty means the summary model (OPENROUTER_MODEL).
OPENROUTER_CHAT_MODEL=
# Embeddings for RAG. EMBEDDING_DIMENSIONS must match the model (changing it means re-indexing).
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Chat retrieval: "hybrid" (default: vector + full-text search, merged) or "vector" (vector only).
RETRIEVAL_MODE=hybrid
# Drop chunks whose cosine similarity is below this; 0 disables the threshold (the measured
# choice, see docs/design.md step 16).
RETRIEVAL_MIN_SIMILARITY=0
# Follow-up questions: when there is earlier conversation, one model call rewrites the last
# question into a standalone one before retrieval (no call without history). Off by default.
QUERY_REWRITE_ENABLED=false
# Optional. Model for the rewrite; empty means the chat model (OPENROUTER_CHAT_MODEL).
QUERY_REWRITE_MODEL=
# Optional. OpenRouter normally returns the exact cost of each call; these prices (USD per
# million tokens) are only used to estimate cost when it doesn't.
# AI_PRICES_PER_MILLION_TOKENS={"openai/gpt-4o": {"prompt": 2.5, "completion": 10}}
# Local Postgres + pgvector from docker-compose.yml (start it with `docker compose up -d`).
DATABASE_URL=postgresql://docsum:docsum@127.0.0.1:5432/docsum
# Optional. Used only by Alembic migrations (python -m alembic ...); empty means DATABASE_URL.
# In production, set it to Neon's direct (unpooled) connection string for the migration run.
MIGRATION_DATABASE_URL=
# Used only by pytest. Every test empties its tables, so it must be a separate *_test database.
TEST_DATABASE_URL=postgresql://docsum:docsum@127.0.0.1:5432/docsum_test
# Evals (python -m evals.run_evals). The eval database is emptied on every run and must end in
# _eval; if unset, it is DATABASE_URL's database name plus "_eval" (created automatically).
EVAL_DATABASE_URL=postgresql://docsum:docsum@127.0.0.1:5432/docsum_eval
# Free OpenRouter models for eval answers and the judge (they must be different models).
EVAL_ANSWER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Free model for query rewriting in evals (--query-rewrite on).
EVAL_REWRITE_MODEL=nvidia/nemotron-3.5-lightning:free
# Pause between model calls in answers mode, to stay under free-tier rate limits.
EVAL_MIN_SECONDS_BETWEEN_CALLS=4
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Production only (Vercel Blob uploads); added by connecting the Blob store in Vercel.
# BLOB_READ_WRITE_TOKEN=
